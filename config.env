# =====================================================================
#  Middle East Infra Contracting LLC - Labour Data Lake
#  Pipeline configuration. Edit the values below to match your VM,
#  then run:  ./run_pipeline.sh
# =====================================================================

# --- Where things are installed ---
# Order: value already set in your shell -> found on PATH -> guess below.
# If a guess is wrong, replace the last path on that line with the real folder.
_home_of() { local p; p="$(command -v "$1" 2>/dev/null)" && dirname "$(dirname "$(readlink -f "$p")")"; }
export HADOOP_HOME="${HADOOP_HOME:-/usr/share/hadoop}"
export SPARK_HOME="${SPARK_HOME:-/usr/share/spark}"
export HIVE_HOME="${HIVE_HOME:-/usr/share/hive}"
export ZEPPELIN_HOME="${ZEPPELIN_HOME:-$(_home_of zeppelin-daemon.sh || echo /home/bigdata/zeppelin)}"
# Lets spark-submit find HDFS, so hdfs:///datalake paths work outside Zeppelin
if [ -z "${HADOOP_CONF_DIR:-}" ]; then
  for d in "$HADOOP_HOME/etc/hadoop" /etc/hadoop/conf /etc/hadoop; do
    [ -f "$d/core-site.xml" ] && { export HADOOP_CONF_DIR="$d"; break; }
  done
fi

# --- Input data on the local disk of the VM ---
# Either the original Data.xlsx or the already-converted labour_raw.csv
export SOURCE_FILE="${SOURCE_FILE:-/home/bigdata/labour_raw.csv}"
# Where the step-2 split files are written locally
export STAGING_DIR="${STAGING_DIR:-/home/bigdata/meic_staging}"

# --- HDFS layout (bronze = raw, silver = cleansed, gold = curated) ---
export HDFS_BASE="/meic_datalake"

# --- Spark ---
# local[*] runs Spark on this VM without YARN. Use "yarn" if YARN is running.
export SPARK_MASTER="local[*]"
export PYSPARK_PYTHON="python3"

# --- Hive ---
# "beeline" talks to HiveServer2 (the same thing Zeppelin's %hive uses).
# Set to "hive" to use the old Hive CLI instead.
export HIVE_MODE="hive"
export HIVE_JDBC_URL="jdbc:hive2://localhost:10000/default"
export HIVE_USER="bigdata"
